{
    "$schema": "https://opencode.ai/config.json",
    "lsp": {
      "air": {
        "command": ["air", "language-server"],
        "extensions": [".r", ".R"]
      }
    },
    "skills": {
      "paths": ["~/.config/opencode/skills"]                                                                                                             
    },
    "permission": {
      "read": "allow",
      "edit": "allow",
      "bash": "allow",
      "external_directory": "allow"
  }
}
